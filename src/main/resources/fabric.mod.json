{
	"schemaVersion": 1,
	"id": "medal-integration-fabric",
	"version": "${version}-alpha",
	"name": "Medal Integration",
	"description": "Client-side mod that detects your player kills (melee and ranged) and automatically saves a clip via Medal's AutoClip API.",
	"authors": [
		"Dandeib"
	],
	"contact": {
		"homepage": "https://github.com/Dandeib/Medal-Integration-Fabric-Mod",
		"sources": "https://github.com/Dandeib/Medal-Integration-Fabric-Mod",
		"issues": "https://github.com/Dandeib/Medal-Integration-Fabric-Mod/issues"
	},
	"license": "PolyForm-Shield-1.0.0",
	"icon": "assets/medal-integration-fabric/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.dandeib.MedalIntegrationFabric"
		],
		"client": [
			"com.dandeib.client.MedalIntegrationFabricClient"
		],
		"fabric-datagen": [
			"com.dandeib.client.MedalIntegrationFabricDataGenerator"
		]
	},
	"mixins": [
		"medal-integration-fabric.mixins.json",
		{
			"config": "medal-integration-fabric.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}